[
  // Navigation
  {
    "key": "ctrl-h",
    "command": "workbench.action.navigateLeft"
  },
  {
    "key": "ctrl-l",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "ctrl-j",
    "command": "workbench.action.navigateDown"
  },
  {
    "key": "ctrl-k",
    "command": "workbench.action.navigateUp"
  },
  {
    "key": "ctrl-f",
    "command": "workbench.action.focusActiveEditorGroup"
  },
  {
    "key": "ctrl-t",
    "command": "workbench.action.terminal.focus"
  },
  {
    "key": "ctrl-e",
    "command": "workbench.action.focusSideBar"
  },
  // Tabs
  {
    "key": "tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "vim.mode == 'Normal' && !inlineSuggestionVisible && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "shift-tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "vim.mode == 'Normal' && !inlineSuggestionVisible && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space b a",
    "command": "workbench.action.closeAllEditors",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space b o",
    "command": "workbench.action.closeOtherEditors",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Command pallete
  {
    "key": "space space",
    "command": "workbench.action.quickOpen",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space f g",
    "command": "periscope.search",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space f b",
    "command": "workbench.action.showAllEditors",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space f a",
    "command": "workbench.action.gotoSymbol",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space f r",
    "command": "workbench.action.openRecent",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space f k",
    "command": "workbench.action.openGlobalKeybindings",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "ctrl-j",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl-k",
    "command": "workbench.action.quickOpenNavigatePrevious",
    "when": "inQuickOpen"
  },
  // Sidebar
  {
    "key": "space e",
    "command": "runCommands",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && !sideBarVisible",
    "args": {
      "commands": ["workbench.action.toggleSidebarVisibility", "workbench.action.focusSideBar"]
    }
  },
  {
    "key": "space e",
    "command": "runCommands",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && sideBarVisible",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.focusActiveEditorGroup"
      ]
    }
  },
  // Sidebar views
  {
    "key": "space v e",
    "command": "workbench.view.explorer",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space v s",
    "command": "workbench.view.search",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space v g",
    "command": "workbench.view.scm",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Lazy git
  {
    "key": "space g g",
    "command": "lazygit.openLazygit",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Explorer
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus && explorerResourceIsFolder"
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "shift-a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "o",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // Window management
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "shift-s",
    "command": "runCommands",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors"
      ]
    }
  },
  {
    "key": "space s v",
    "command": "workbench.action.splitEditorRight",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space s h",
    "command": "workbench.action.splitEditorDown",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space s e",
    "command": "workbench.action.evenEditorWidths",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space s x",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "alt+h",
    "command": "workbench.action.increaseViewWidth",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "alt+l",
    "command": "workbench.action.decreaseViewWidth",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "alt+j",
    "command": "workbench.action.increaseViewHeight",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "alt+k",
    "command": "workbench.action.decreaseViewHeight",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space p",
    "command": "markdown.showPreviewToSide",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Terminal
  {
    "key": "space t t",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space t v",
    "command": "runCommands",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)",
    "args": {
      "commands": ["workbench.action.splitEditorRight", "workbench.action.createTerminalEditor"]
    }
  },
  {
    "key": "ctrl-o",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-d",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-v",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-h",
    "command": "workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-n",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-p",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl-l",
    "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus"
  },
  {
    "key": "alt-j",
    "command": "workbench.action.terminal.resizePaneDown",
    "when": "terminalFocus"
  },
  {
    "key": "alt-k",
    "command": "workbench.action.terminal.resizePaneUp",
    "when": "terminalFocus"
  },
  {
    "key": "alt-h",
    "command": "workbench.action.terminal.resizePaneLeft",
    "when": "terminalFocus"
  },
  {
    "key": "alt-l",
    "command": "workbench.action.terminal.resizePaneRight",
    "when": "terminalFocus"
  },
  {
    "key": "space t f",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Coding
  {
    "key": "tab",
    "command": "editor.action.indentLines",
    "when": "vim.mode == 'Insert' && editorTextFocus && !editorReadonly && !inlineSuggestionVisible"
  },
  {
    "key": "shift-tab",
    "command": "editor.action.outdentLines",
    "when": "vim.mode == 'Insert' && editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift-j",
    "command": "editor.action.moveLinesDownAction",
    "when": "vim.mode != 'Insert' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "shift-k",
    "command": "editor.action.moveLinesUpAction",
    "when": "vim.mode != 'Insert' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "shift-k",
    "command": "editor.action.showHover",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space c a",
    "command": "editor.action.codeAction",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space c r",
    "command": "editor.action.rename",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space c f",
    "command": "editor.action.formatDocument",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space c o",
    "command": "editor.action.organizeImports",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  // Diagnostics
  {
    "key": "space x x",
    "command": "workbench.actions.view.problems",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space g r",
    "command": "editor.action.goToReferences",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space g i",
    "command": "editor.action.goToImplementation",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space g d",
    "command": "editor.action.revealDefinition",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space g D",
    "command": "editor.action.goToDeclaration",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space g t",
    "command": "editor.action.goToTypeDefinition",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "ctrl-n",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "(vim.mode == 'Normal' || vim.mode == 'Visual') && (editorTextFocus || !inputFocus)"
  },
  // Folding
  {
    "key": "space z c",
    "command": "editor.fold",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space z o",
    "command": "editor.unfold",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space z a",
    "command": "editor.toggleFold",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space z m",
    "command": "editor.foldAll",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  {
    "key": "space z r",
    "command": "editor.unfoldAll",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  // Suggestions (autocomplete)
  {
    "key": "ctrl-j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl-k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible"
  },
  {
    "key": "ctrl-y",
    "command": "acceptSelectedSuggestion",
    "when": "suggestWidgetVisible"
  },
  // Copilot
  {
    "key": "ctrl-f",
    "command": "editor.action.inlineSuggest.commit",
    "when": "(vim.mode == 'Insert' || vim.mode == 'Normal') && editorTextFocus && inlineSuggestionVisible"
  },
  {
    "key": "ctrl-f",
    "command": "github.copilot.acceptCursorPanelSolution",
    "when": "(vim.mode == 'Insert' || vim.mode == 'Normal') && editorTextFocus && github.copilot.panelVisible"
  },
  {
    "key": "ctrl-n",
    "command": "editor.action.inlineSuggest.showNext",
    "when": "(vim.mode == 'Insert' || vim.mode == 'Normal') && editorTextFocus && inlineSuggestionVisible"
  },
  {
    "key": "ctrl-p",
    "command": "editor.action.inlineSuggest.showPrevious",
    "when": "(vim.mode == 'Insert' || vim.mode == 'Normal') && editorTextFocus && inlineSuggestionVisible"
  },
  {
    "key": "ctrl-c",
    "command": "workbench.panel.chat.view.copilot.focus"
  },
  {
    "key": "space a c",
    "command": "workbench.action.chat.toggle",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space a n",
    "command": "workbench.action.chat.newChat",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "ctrl-q",
    "command": "workbench.action.chat.toggleAgentMode",
    "when": "chatIsEnabled && inChat"
  },
  {
    "key": "space a h",
    "command": "workbench.action.chat.history",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space a f",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  // Diagnostics
  {
    "key": "space q",
    "command": "workbench.actions.view.problems",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d d",
    "command": "editor.action.showHover",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  // Debug
  {
    "key": "space d s",
    "command": "workbench.action.debug.start",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d c",
    "command": "workbench.action.debug.continue",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d i",
    "command": "workbench.action.debug.stepInto",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d o",
    "command": "workbench.action.debug.stepOver",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space shift+d o",
    "command": "workbench.action.debug.stepOut",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space shift+d b",
    "command": "editor.debug.action.conditionalBreakpoint",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d x",
    "command": "workbench.debug.viewlet.action.removeAllBreakpoints",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d q",
    "command": "workbench.action.debug.stop",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  },
  {
    "key": "space d u",
    "command": "workbench.debug.action.focusRepl",
    "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"
  }
]
