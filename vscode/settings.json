{
  // General
  "workbench.startupEditor": "none",
  "explorer.sortOrder": "filesFirst",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "charliermarsh.ruff",
  "editor.tabSize": 2,
  "editor.insertSpaces": false,
  "extensions.ignoreRecommendations": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.goToImplementation",
  "editor.lineNumbers": "relative",
  "vscode_custom_css.imports": [
    "file:///c:/Users/joaki/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
  ],
  "animations.Enabled": true,
  "editor.largeFileOptimizations": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  // Theme
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Bearded Theme Monokai Terra",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  // Sveltekit
  "svelte.enable-ts-plugin": true,
  "workbench.editor.customLabels.patterns": {
    "*/src/**/+layout.server.ts": "[LS] ${dirname}",
    "*/src/**/+page.server.ts": "[PS] ${dirname}",
    "*/src/**/+page.svelte": "[P] ${dirname}",
    "*/src/**/+layout.svelte": "[L] ${dirname}",
    "*/src/**/+server.ts": "[S] ${dirname}",
    "*/src/**/+page.ts": "[p] ${dirname}",
    "*/src/**/+layout.ts": "[l] ${dirname}"
  },
  // Prettier
  "prettier.printWidth": 100,
  // CoPilot
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "go": false
  },
  // Vim
  "vim.easymotion": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.useSystemClipboard": true,
  "vim.leader": " ",
  "editor.fontSize": 14,
  "[python]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": false,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "explorer.compactFolders": false,
  "python.analysis.extraPaths": ["${workspaceFolder}/.venv/**"],
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.confirmSync": false,
  "git.suggestSmartCommit": false,
  "chat.mcp.serverSampling": {
    "Global in Code: todo": {
      "allowedModels": ["copilot/gpt-4.1"]
    }
  },
  "chat.mcp.autostart": "never",
  "[bicep]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-bicep"
  },
  "[terraform]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.tabSize": 2 // optionally
  },
  "[terraform-vars]": {
    "editor.tabSize": 2 // optionally
  },
  "workbench.sideBar.location": "right",
  "[svelte]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
