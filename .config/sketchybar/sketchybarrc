#!/usr/bin/env bash
# SketchyBar config — active theme, AeroSpace-driven.
# Workspaces show the app icons they contain; right side has clock/battery/volume.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Custom events #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event keyboard_change

##### Keyboard-layout listener #####
# Instant input-source updates via a tiny Swift listener on the TIS
# distributed notification. Compile + launch in the background so a cold
# `swiftc` never blocks bar startup; the keyboard item's update_freq is the
# fallback until the listener is up.
KB_SRC="$CONFIG_DIR/helpers/keyboard_listener.swift"
KB_BIN="$CONFIG_DIR/helpers/keyboard_listener"
pkill -f "$KB_BIN" 2>/dev/null
{
  if [ ! -x "$KB_BIN" ] || [ "$KB_SRC" -nt "$KB_BIN" ]; then
    swiftc -O "$KB_SRC" -o "$KB_BIN" 2>/dev/null
  fi
  [ -x "$KB_BIN" ] && exec "$KB_BIN"
} &

##### Dock-badge reader #####
# Compile + ad-hoc sign the badge helper once (in the background). Compiled
# only when missing so its Accessibility grant survives reloads; the .swift
# source is tracked, the binary is git-ignored and needs a one-time
# Accessibility grant (run: helpers/dock_badges prompt).
BADGE_SRC="$CONFIG_DIR/helpers/dock_badges.swift"
BADGE_BIN="$CONFIG_DIR/helpers/dock_badges"
{
  if [ ! -x "$BADGE_BIN" ]; then
    swiftc -O "$BADGE_SRC" -o "$BADGE_BIN" 2>/dev/null \
      && codesign --force --sign - "$BADGE_BIN" 2>/dev/null
  fi
} &

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=40 \
  blur_radius=30 \
  color="$BAR_COLOR" \
  padding_left=8 \
  padding_right=8 \
  drawing=on

##### Global defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  icon.color="$FG"
  label.font="Hack Nerd Font:Bold:13.0"
  label.color="$FG"
  background.corner_radius=9
  background.height=26
  background.border_width=1
  background.border_color="$TRANSPARENT"
  icon.padding_left=8
  icon.padding_right=8
  label.padding_left=4
  label.padding_right=8
)
sketchybar --default "${default[@]}"

##### Workspaces (left) #####
# Workspace chips + the app icons each contains are created dynamically by
# spaces.sh (one item per app so badged apps can show a count). The hidden
# manager drives it on workspace/app changes and every 3s for Dock badges.
# Reset the render caches so a fresh start always rebuilds the items, and prime
# the monitor signature so the first cross-monitor switch doesn't force a rebuild.
rm -f /tmp/sketchybar_spaces_state /tmp/sketchybar_spaces_brackets
aerospace list-monitors > /tmp/sketchybar_spaces_monitors 2>/dev/null
sketchybar --add item spaces_manager left \
  --set spaces_manager \
    drawing=off \
    updates=on \
    update_freq=3 \
    script="$PLUGIN_DIR/spaces.sh" \
  --subscribe spaces_manager aerospace_workspace_change front_app_switched system_woke display_change

##### Front app (left) #####
sketchybar --add item front_app left \
  --set front_app \
    background.color="$TRANSPARENT" \
    icon.padding_left=10 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Right-side items #####
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon="" \
    icon.color="$LAVENDER" \
    label.color="$FG" \
    background.color="$BG_SURFACE" \
    script="$PLUGIN_DIR/clock.sh" \
  --add item battery right \
  --set battery \
    update_freq=120 \
    background.color="$TRANSPARENT" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item volume right \
  --set volume \
    icon.color="$CYAN" \
    background.color="$TRANSPARENT" \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  --add item keyboard right \
  --set keyboard \
    update_freq=10 \
    icon="󰌌" \
    icon.color="$KHAKI" \
    label.color="$FG" \
    background.color="$TRANSPARENT" \
    script="$PLUGIN_DIR/keyboard.sh" \
  --subscribe keyboard keyboard_change

##### Finalize #####
sketchybar --update
sketchybar --trigger aerospace_workspace_change
