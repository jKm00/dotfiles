#!/usr/bin/env bash
# SketchyBar config — oasis.nvim "twilight" theme, AeroSpace-driven.
# Workspaces show the app icons they contain; right side has clock/battery/volume.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Custom events #####
sketchybar --add event aerospace_workspace_change

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=40 \
  blur_radius=30 \
  color="$BAR_COLOR" \
  padding_left=8 \
  padding_right=8 \
  drawing=on

##### Global defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  icon.color="$FG"
  label.font="Hack Nerd Font:Bold:13.0"
  label.color="$FG"
  background.corner_radius=9
  background.height=26
  background.border_width=1
  background.border_color="$TRANSPARENT"
  icon.padding_left=8
  icon.padding_right=8
  label.padding_left=4
  label.padding_right=8
)
sketchybar --default "${default[@]}"

##### Workspace chips (left) #####
# One item per AeroSpace workspace; contents/highlight are managed by spaces.sh.
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space."$sid" left \
    --set space."$sid" \
      icon="$sid" \
      icon.font="Hack Nerd Font:Bold:13.0" \
      icon.padding_left=9 \
      icon.padding_right=4 \
      label.font="sketchybar-app-font:Regular:16.0" \
      label.padding_left=2 \
      label.padding_right=9 \
      background.color="$ITEM_BG" \
      background.border_color="$BG_MANTLE" \
      background.drawing=on \
      drawing=off \
      click_script="aerospace workspace $sid; sketchybar --trigger aerospace_workspace_change"
done

# Hidden manager item: re-renders all workspace chips on relevant events.
sketchybar --add item spaces_manager left \
  --set spaces_manager \
    drawing=off \
    updates=on \
    update_freq=15 \
    script="$PLUGIN_DIR/spaces.sh" \
  --subscribe spaces_manager aerospace_workspace_change front_app_switched

##### Front app (left) #####
sketchybar --add item front_app left \
  --set front_app \
    background.color="$TRANSPARENT" \
    icon.padding_left=10 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Right-side items #####
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon="" \
    icon.color="$LAVENDER" \
    label.color="$FG" \
    background.color="$BG_SURFACE" \
    script="$PLUGIN_DIR/clock.sh" \
  --add item battery right \
  --set battery \
    update_freq=120 \
    background.color="$TRANSPARENT" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item volume right \
  --set volume \
    icon.color="$CYAN" \
    background.color="$TRANSPARENT" \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

##### Finalize #####
sketchybar --update
sketchybar --trigger aerospace_workspace_change
