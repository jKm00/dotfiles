// Example .vscode/launch.json configurations for JavaScript/TypeScript projects
// Copy the relevant configuration to your project's .vscode/launch.json
//
// DAP Keybindings:
//   <leader>da - Run with args    | <leader>db - Toggle breakpoint
//   <leader>dc - Run/Continue     | <leader>di - Step into
//   <leader>do - Step over        | <leader>dO - Step out
//   <leader>dg - Goto line        | <leader>dC - Run to cursor
//   <leader>de - Evaluate         | <leader>dr - Toggle REPL
//   <leader>du - Toggle UI        | <leader>dx - Clear breakpoints

// =============================================================================
// SINGLE TYPESCRIPT FILE
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "TS File: ts-node",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "ts-node",
      "args": [],
      "sourceMaps": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "JS File: node",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}

// =============================================================================
// EXPRESS / NODE.JS API SERVER
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Express: ts-node",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "ts-node",
      "restart": true,
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Express: nodemon",
      "runtimeExecutable": "nodemon",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "restart": true,
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Express: compiled",
      "program": "${workspaceFolder}/dist/index.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "npm: build",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}

// =============================================================================
// NEXT.JS PROJECT (FULL-STACK)
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Next.js: dev server",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ready - started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Next.js: Chrome browser",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Next.js: Full Stack",
      "configurations": ["Next.js: dev server", "Next.js: Chrome browser"],
      "stopAll": true
    }
  ]
}
// =============================================================================
// TANSTACK START (FULL-STACK FRAMEWORK)
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "TanStack Start: dev",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "listening on (https?://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "TanStack Start: browser",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "TanStack Start: Full Stack",
      "configurations": ["TanStack Start: dev", "TanStack Start: browser"],
      "stopAll": true
    }
  ]
}

// =============================================================================
// VITE + REACT PROJECT (CLIENT-SIDE)
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Vite: dev server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:.*(https?://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Vite: Chrome browser",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Vite: Full Stack Debug",
      "configurations": ["Vite: dev server", "Vite: Chrome browser"],
      "stopAll": true
    }
  ]
}

// =============================================================================
// JEST TESTS
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Jest: Debug Current Test File",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["${fileBasenameNoExtension}", "--runInBand"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Jest: Debug All Tests",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}

// =============================================================================
// VITEST TESTS
// =============================================================================
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug Vitest Tests",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test"],
      "console": "integratedTerminal"
    }
  ]
}
